# Only what the relayer and demo host images need leaves this machine; internal/, .env* and the rest never do.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!packages/annon/package.json
!packages/annon-mcp/package.json
!packages/annon/src
!apps/relayer/package.json
!apps/relayer/*.ts
!apps/relayer/ts-hook.mjs
!apps/demo-host/package.json
!apps/demo-host/*.ts
!apps/demo-host/ts-hook.mjs
**/*.test.ts
**/.env*
**/vitest.config.ts
**/fixtures
**/*.pem
**/*.log
**/logs
**/node_modules
**/.DS_Store

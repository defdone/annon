{
  "name": "@defdone/annon",
  "version": "0.0.0",
  "private": true,
  "description": "Files only the buyer can open: encrypted on the client, the key released by NEAR once the payment is verified.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "dist": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "fake-indexeddb": "6.2.6",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "near-api-js": "7.4.0",
    "viem": "2.57.10"
  }
}

{
  "name": "@defdone/annon",
  "version": "0.1.0-beta.0",
  "description": "Files only the buyer can open: encrypted on the client, the key released by NEAR once the payment is verified.",
  "license": "Apache-2.0",
  "homepage": "https://annon.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defdone/annon.git",
    "directory": "packages/annon"
  },
  "bugs": {
    "url": "https://github.com/defdone/annon/issues"
  },
  "keywords": [
    "near",
    "x402",
    "encryption",
    "payments",
    "usdc",
    "mpc",
    "files",
    "agents",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "type": "module",
  "bin": {
    "annon": "./dist/node/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./browser/purchase-bundle.js": "./dist/browser/purchase-bundle.js",
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./relay": {
      "types": "./dist/relay/index.d.ts",
      "default": "./dist/relay/index.js"
    },
    "./download/host": {
      "types": "./dist/download/host.d.ts",
      "default": "./dist/download/host.js"
    },
    "./download/http": {
      "types": "./dist/download/http.d.ts",
      "default": "./dist/download/http.js"
    },
    "./envelope/pay2": {
      "types": "./dist/envelope/pay2.d.ts",
      "default": "./dist/envelope/pay2.js"
    },
    "./near/rpc": {
      "types": "./dist/near/rpc.d.ts",
      "default": "./dist/near/rpc.js"
    },
    "./pay/seller": {
      "types": "./dist/pay/seller.d.ts",
      "default": "./dist/pay/seller.js"
    },
    "./pay/settle": {
      "types": "./dist/pay/settle.d.ts",
      "default": "./dist/pay/settle.js"
    },
    "./pay/split": {
      "types": "./dist/pay/split.d.ts",
      "default": "./dist/pay/split.js"
    },
    "./pay/store": {
      "types": "./dist/pay/store.d.ts",
      "default": "./dist/pay/store.js"
    },
    "./pay/store-node": {
      "types": "./dist/pay/store-node.d.ts",
      "default": "./dist/pay/store-node.js"
    },
    "./node/signer-mock": {
      "types": "./dist/node/signer-mock.d.ts",
      "default": "./dist/node/signer-mock.js"
    },
    "./node/adapter": {
      "types": "./dist/node/adapter.d.ts",
      "default": "./dist/node/adapter.js"
    },
    "./node/cli": {
      "types": "./dist/node/cli.d.ts",
      "default": "./dist/node/cli.js"
    },
    "./node/errors": {
      "types": "./dist/node/errors.d.ts",
      "default": "./dist/node/errors.js"
    }
  },
  "files": [
    "dist",
    "CLI.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --noEmit && tsc -p tsconfig.build.json && node scripts/build-browser.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "@types/node": "26.6.5",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "util": "0.12.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "near-api-js": "7.4.0",
    "viem": "2.57.10"
  }
}

{
  "name": "@defdone/annon-mcp",
  "version": "0.1.0-beta.0",
  "description": "Local stdio MCP tools for selling, buying, opening and verifying Annon files.",
  "license": "Apache-2.0",
  "homepage": "https://annon.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defdone/annon.git",
    "directory": "packages/annon-mcp"
  },
  "bugs": {
    "url": "https://github.com/defdone/annon/issues"
  },
  "keywords": [
    "mcp",
    "near",
    "x402",
    "agents",
    "payments",
    "encryption"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "type": "module",
  "bin": {
    "annon-mcp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --noEmit && tsc -p tsconfig.build.json --sourceMap false",
    "test": "vitest run"
  },
  "dependencies": {
    "@defdone/annon": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "viem": "2.57.10",
    "vitest": "5.0.5"
  }
}
